{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "types": [
      "node"
    ],
    "paths": {
      "@windows-runner/shared": [
        "../shared/dist/index.d.ts"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "test",
    "e2e",
    "dist",
    "node_modules"
  ]
}
