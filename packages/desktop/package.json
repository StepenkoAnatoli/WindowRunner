{
  "name": "@windows-runner/desktop",
  "productName": "WindowRunner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop shell for WindowRunner: boots the bundled server and loads the /desktop UI.",
  "author": "StepenkoAnatoli",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:page": "tsx --test test/page-smoke.ts",
    "smoke:electron": "tsx --test test/electron-smoke.ts",
    "e2e": "playwright test",
    "package:win": "electron-builder --win nsis --config electron-builder.yml",
    "package:win:release": "electron-builder --win nsis --config electron-builder.yml -c.forceCodeSigning=true",
    "pretest": "node ../../scripts/ensure-built.mjs --desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^138.0.2",
    "@types/node": "^26.6.2",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@windows-runner/shared": "*"
  }
}
