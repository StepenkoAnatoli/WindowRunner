{
  "name": "windows-runner",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "A local-first, desktop coding agent you run with your own API keys. Windows Runner.",
  "type": "module",
  "main": "packages/server/dist/index.cjs",
  "bin": {
    "windows-runner": "./bin/windows-runner.js",
    "wr": "./bin/windows-runner.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StepenkoAnatoli/WindowRunner.git"
  },
  "homepage": "https://github.com/StepenkoAnatoli/WindowRunner#readme",
  "bugs": {
    "url": "https://github.com/StepenkoAnatoli/WindowRunner/issues"
  },
  "keywords": [
    "coding-agent",
    "local-first",
    "windows-runner",
    "ai",
    "developer-tools"
  ],
  "author": "StepenkoAnatoli",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "packages/shared/dist/",
    "packages/server/dist/",
    "packages/web/dist/",
    "scripts/postinstall.mjs",
    "scripts/ensure-built.mjs",
    "docs/INSTALL.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "Setup-WindowRunner.cmd",
    "Start-WindowRunner.cmd"
  ],
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/shared && npm run build --workspace packages/server && npm run build --workspace packages/web",
    "check:release": "node scripts/check-release.mjs",
    "typecheck": "npm run typecheck --workspace packages/shared && npm run typecheck --workspace packages/server && npm run typecheck --workspace packages/web",
    "pretest": "node scripts/check-test-env.mjs && node scripts/ensure-built.mjs",
    "test": "npm run test --workspace packages/shared && npm run test --workspace packages/server && npm run test --workspace packages/web && npm run test --workspace packages/desktop",
    "build:desktop": "npm run build --workspace packages/desktop",
    "typecheck:desktop": "npm run typecheck --workspace packages/desktop",
    "test:desktop": "npm run test --workspace packages/desktop",
    "smoke:desktop": "npm run smoke:page --workspace packages/desktop && npm run smoke:electron --workspace packages/desktop",
    "e2e:desktop": "npm run e2e --workspace packages/desktop",
    "package:desktop:win": "npm run package:win --workspace packages/desktop",
    "package:desktop:win:release": "npm run package:win:release --workspace packages/desktop",
    "setup": "node scripts/setup.mjs",
    "prestart": "node scripts/ensure-built.mjs",
    "start": "node packages/server/dist/index.cjs",
    "dev": "npm run dev --workspace packages/server",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "smoke:packed:start": "node scripts/smoke-packed-start.mjs",
    "smoke:start": "node scripts/smoke-start.mjs",
    "eval": "tsx eval/run.mts",
    "validate:provider": "tsx eval/validate-provider.mts",
    "e2e": "npm run e2e --workspace packages/web",
    "e2e:install": "npm run e2e:install --workspace packages/web",
    "smoke:launchers": "node scripts/smoke-launchers.mjs"
  }
}
